{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "RailPulse DE — Pipeline Health Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Events Published (total)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(railpulse_ingestion_events_published_total)",
          "legendFormat": "Published"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "DLQ Events (total)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(railpulse_ingestion_events_dlq_total)",
          "legendFormat": "DLQ"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Fetch Errors (total)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(railpulse_ingestion_fetch_errors_total)",
          "legendFormat": "Errors"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Avg Fetch Latency (s)",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(railpulse_ingestion_fetch_latency_seconds_sum[5m]) / rate(railpulse_ingestion_fetch_latency_seconds_count[5m])",
          "legendFormat": "Avg Latency"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Events Published per Type (rate 1m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(railpulse_ingestion_events_published_total[1m])",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "DLQ Rate vs Published Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(railpulse_ingestion_events_published_total[1m])",
          "legendFormat": "Published/s"
        },
        {
          "expr": "rate(railpulse_ingestion_events_dlq_total[1m])",
          "legendFormat": "DLQ/s"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "title": "Fetch Latency Histogram (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(railpulse_ingestion_fetch_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(railpulse_ingestion_fetch_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(railpulse_ingestion_fetch_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["railpulse", "pipeline"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "RailPulse Pipeline Health",
  "uid": "railpulse-pipeline-health",
  "version": 1
}